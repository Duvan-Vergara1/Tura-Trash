# Copia este archivo como .env y ajusta los valores.

# Conexión a PostgreSQL (local o en la nube)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tura_trash
# true si la base de datos está en la nube y exige SSL (Render, Railway, Neon...)
DATABASE_SSL=false

# Base de datos SOLO para las pruebas automáticas (npm test la borra y la recrea)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tura_trash_test

PORT=4000

# Clave para firmar los tokens. En producción: cadena aleatoria de 32+ caracteres.
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# URL(s) del frontend permitidas, separadas por coma
CORS_ORIGIN=http://localhost:5173

# Administrador inicial (lo usan npm run db:seed y npm run create-admin)
ADMIN_NOMBRE=Administrador Tura Trash
ADMIN_EMAIL=admin@turatrash.co
ADMIN_PASSWORD=Admin123*
